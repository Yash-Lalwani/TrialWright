{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sample": "node scripts/generate-sample.mjs",
    "pdf-assets": "node scripts/copy-pdf-assets.mjs",
    "predev": "npm run sample && npm run pdf-assets",
    "dev": "next dev",
    "prebuild": "npm run sample && npm run pdf-assets",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "pretest": "npm run sample",
    "test": "node --test \"tests/**/*.test.mjs\""
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-pdf": "^11.0.0",
    "shadcn": "^4.21.4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "pdf-lib": "^1.17.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
