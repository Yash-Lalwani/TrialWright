# Frontend-local ignores. The root .gitignore (owned by Person A) is the source of
# truth; these entries keep frontend/ safe until it lands. See CONTRACTS.md §6.1.

# Markdown is never pushed (includes generated AGENTS.md / README.md)
*.md

# dependencies and build output
/node_modules
/.next/
/out/
/build
/.vercel
*.tsbuildinfo
next-env.d.ts

# env: only the example is committed
.env
.env.*
!.env.example

# generated at predev/prebuild; PDFs are never committed
*.pdf
/public/pdfjs/

# logs and OS files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.DS_Store
