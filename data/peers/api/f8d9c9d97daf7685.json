{"protocolSection": {"identificationModule": {"nctId": "NCT06126497", "orgStudyIdInfo": {"id": "CTP2S1911A4B2"}, "organization": {"fullName": "Suven Life Sciences Limited", "class": "INDUSTRY"}, "briefTitle": "Study Evaluating Safety and Efficacy of Ropanicant in MDD Patients", "officialTitle": "An Open-Label Study Evaluating the Safety and Efficacy of Ropanicant in Participants With Moderate to Severe Major Depressive Disorder"}, "statusModule": {"statusVerifiedDate": "2026-08", "overallStatus": "COMPLETED", "expandedAccessInfo": {"hasExpandedAccess": false}, "startDateStruct": {"date": "2024-02-05", "type": "ACTUAL"}, "primaryCompletionDateStruct": {"date": "2024-07-19", "type": "ACTUAL"}, "completionDateStruct": {"date": "2024-07-19", "type": "ACTUAL"}, "studyFirstSubmitDate": "2023-11-06", "studyFirstSubmitQcDate": "2023-11-06", "studyFirstPostDateStruct": {"date": "2023-11-13", "type": "ACTUAL"}, "resultsFirstSubmitDate": "2026-04-28", "resultsFirstSubmitQcDate": "2026-08-29", "resultsFirstPostDateStruct": {"date": "2026-09-01", "type": "ACTUAL"}, "lastUpdateSubmitDate": "2026-08-29", "lastUpdatePostDateStruct": {"date": "2026-09-01", "type": "ACTUAL"}}, "sponsorCollaboratorsModule": {"responsibleParty": {"type": "SPONSOR"}, "leadSponsor": {"name": "Suven Life Sciences Limited", "class": "INDUSTRY"}}, "oversightModule": {"oversightHasDmc": false, "isFdaRegulatedDrug": true, "isFdaRegulatedDevice": false}, "descriptionModule": {"briefSummary": "This is an open-label, parallel-group study to evaluate the safety and efficacy of Ropanicant in participants with moderate to severe Major Depressive Disorder (MDD).", "detailedDescription": "Approximately 36 participants will be randomly assigned to receive Ropanicant either Ropanicant 45 mg once a day (QD), Ropanicant 30 mg twice a day (BID), or Ropanicant 45 mg BID for 2 weeks, in a ratio of 1:1:1 (12 participants in each treatment group). Following a screening period of up to 4 weeks, the participants will be treated for 2 weeks."}, "conditionsModule": {"conditions": ["Major Depressive Disorder"], "keywords": ["SUVN-911", "Phase-2", "MDD", "Depression", "Open label"]}, "designModule": {"studyType": "INTERVENTIONAL", "phases": ["PHASE2"], "designInfo": {"allocation": "RANDOMIZED", "interventionModel": "PARALLEL", "interventionModelDescription": "Open label study", "primaryPurpose": "TREATMENT", "maskingInfo": {"masking": "NONE"}}, "enrollmentInfo": {"count": 41, "type": "ACTUAL"}}, "armsInterventionsModule": {"armGroups": [{"label": "Ropanicant 45 mg QD", "type": "EXPERIMENTAL", "description": "The participant will take 1 tablet/day in the morning (for qd dosing)", "interventionNames": ["Drug: Ropanicant"]}, {"label": "Ropanicant 30 mg BID", "type": "EXPERIMENTAL", "description": "The participant will take 2 tablets/day (\\~12 hours apart for bid dosing).", "interventionNames": ["Drug: Ropanicant"]}, {"label": "Ropanicant 45 mg BID", "type": "EXPERIMENTAL", "description": "The participant will take 2 tablets/day (\\~12 hours apart for bid dosing).", "interventionNames": ["Drug: Ropanicant"]}], "interventions": [{"type": "DRUG", "name": "Ropanicant", "description": "Tablet", "armGroupLabels": ["Ropanicant 30 mg BID", "Ropanicant 45 mg BID", "Ropanicant 45 mg QD"], "otherNames": ["SUVN-911"]}]}, "outcomesModule": {"primaryOutcomes": [{"measure": "Number of Participants With Treatment-Emergent Adverse Events", "description": "Participants with at least one Treatment-emergent adverse events (TEAEs) reported during the duration of the study.", "timeFrame": "From Screening to Day 21"}], "secondaryOutcomes": [{"measure": "Montgomery-\u00c5sberg Depression Rating Scale (MADRS) Score", "description": "Change from the baseline to the MADRS total score. The MADRS is a clinician-rated scale to assess depressive symptoms which consists of 10 items. The time frame for this scale is the past 7 days. Each item is scored on 7-point scale (0 \\[absence of symptoms\\] to 6 \\[severe\\]). The total score is the sum of 10 items and can take range from 0 to 60. A higher score represents a higher severity of the level of depression.", "timeFrame": "From Baseline to Day 14"}]}, "eligibilityModule": {"eligibilityCriteria": "Inclusion Criteria:\n\n* Participants must meet the DSM-5 criteria for MDD without psychotic features and diagnosis confirmed by the Mini-International Neuropsychiatric Interview (MINI).\n* Participants with a current major depressive episode of at least 4 weeks of duration prior to the screening visit.\n* Participants must have an MADRS score of \u226525 at the screening and the baseline visits.\n* Participants must have a score of \u22654 on Clinical Global Impression - Severity (CGI-S) Scale at the screening and the baseline visits.\n\nExclusion Criteria:\n\n* Participants who meet criteria for treatment-resistant depression during the current major depressive episode, which will be defined as being non-responders (less than 50% of symptom improvement) to 2 or more depression treatment periods of adequate dose and duration as defined by the Massachusetts General Hospital (MGH) Antidepressant Treatment Response Questionnaire (ATRQ).\n* Participants taking antidepressant treatment (SSRIs and SNRIs) or any medication that is contraindicated with the use of monoamine oxidase inhibitors (eg, opioids, stimulants) within 2 weeks (or 5 half-lives, whichever is longer) prior to baseline and until the end of study visit.\n* Participants who do not agree to avoid tyramine rich diet from the start of dosing and until 2 weeks following last study drug administration.\n* Participants who are habitual smokers or using nicotine products.", "healthyVolunteers": false, "sex": "ALL", "minimumAge": "18 Years", "maximumAge": "65 Years", "stdAges": ["ADULT", "OLDER_ADULT"]}, "contactsLocationsModule": {"locations": [{"facility": "Clinical Innovations, Inc", "city": "Bellflower", "state": "California", "zip": "90706", "country": "United States", "geoPoint": {"lat"