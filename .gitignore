# --- Markdown: only the README and the design docs are published ---
*.md
!README.md
!docs/*.md
docs/team/

# --- Secrets ---
.env
.env.*
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/

# --- Node / Next.js ---
node_modules/
frontend/.next/
frontend/out/
frontend/.vercel/
*.tsbuildinfo
next-env.d.ts
